      "format": "byte"
    },
    "lod0": {
      "type": "boolean"
    },
    "normal": {
      "type": "boolean"
    },
    "reflective": {
      "type": "boolean"
    },
    "windData": {
      "type": "integer",
      "format": "byte"
    },
    "windMode": {
      "$ref": "./EnumWindBitMode.json#"
    },
    "zOffset": {
      "type": "integer",
      "format": "byte"
    }
  }
