{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "GrindingProperties",
  "$id": "GrindingProperties.json",
  "type": "object",
  "properties": {
    "groundStack": {
      "description": "If set, the collectible is grindable in a quern and this is the resulting itemstack once the grinding time is over.",
      "allOf": [
        {
          "$ref": "./JsonItemStack.json#"
        }
      ]
    },
    "grindedStack": {
      "description": "Obsolete. Please use GroundStack instead.",
      "allOf": [
        {
          "$ref": "./JsonItemStack.json#"
        }
      ]
    }
  }
}
